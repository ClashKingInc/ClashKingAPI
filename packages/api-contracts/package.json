{
  "name": "@clashking/api-contracts",
  "version": "0.1.0-rc.86",
  "license": "SEE LICENSE IN LICENSE",
  "description": "Browser-safe Effect schemas and endpoint metadata for the ClashKing v2 API",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ClashKingInc/ClashKingAPI.git",
    "directory": "packages/api-contracts"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./expo": {
      "types": "./dist/expo.d.ts",
      "import": "./dist/expo.js"
    },
    "./deferred-runtime": {
      "types": "./dist/deferred-runtime.d.ts",
      "import": "./dist/deferred-runtime.js"
    }
  },
  "scripts": {
    "prepack": "node ../../scripts/prepare-package-license.mjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false"
  },
  "dependencies": {
    "effect": "4.1.3"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@clashking/clash-contract": "^1.1.3",
    "effect": "4.1.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  }
}
