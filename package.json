{
  "name": "@clashking/api-workspace",
  "version": "0.1.0-rc.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "workers/api"
  ],
  "engines": {
    "node": ">=26.0.0",
    "npm": ">=12.0.0"
  },
  "scripts": {
    "build": "npm run build --workspace @clashking/api-contracts && npm run build --workspace @clashking/api-client && npm run build --workspace @clashking/api-worker",
    "clean": "node -e \"for (const path of ['packages/api-contracts/dist','packages/api-client/dist','workers/api/dist']) require('fs').rmSync(path,{recursive:true,force:true})\"",
    "contracts:pack": "npm pack --workspace @clashking/api-contracts --pack-destination dist/packages && npm pack --workspace @clashking/api-client --pack-destination dist/packages",
    "openapi:generate": "npm run build --workspace @clashking/api-contracts && node scripts/generate-openapi.mjs",
    "openapi:check": "npm run openapi:generate && node scripts/check-openapi.mjs",
    "parity:report": "npm run build --workspace @clashking/api-contracts && node scripts/check-route-parity.mjs --write",
    "parity:check": "npm run build --workspace @clashking/api-contracts && node scripts/check-route-parity.mjs --check",
    "lint": "oxlint --deny-warnings --ignore-pattern '**/dist/**' packages workers/api",
    "test": "vitest run",
    "test:durable": "vitest run --config vitest.durable.config.ts",
    "test:archive-runtime": "vitest run --config vitest.archive-runtime.config.ts",
    "test:postgres": "vitest run --config vitest.postgres.config.ts",
    "test:postgres:all": "bash scripts/test-postgres.sh",
    "test:scripts": "node --test scripts/*.test.mjs",
    "typecheck": "npm run build --workspace @clashking/api-contracts && npm run typecheck --workspace @clashking/api-client && npm run typecheck --workspace @clashking/api-worker",
    "worker:build": "npm run build --workspace @clashking/api-worker",
    "worker:types": "npm run types --workspace @clashking/api-worker",
    "worker:dry-run": "npm run deploy:dry-run --workspace @clashking/api-worker"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@types/node": "26.4.1",
    "oxlint": "1.81.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "wrangler": "4.128.0"
  },
  "dependencies": {
    "@bokuweb/zstd-wasm": "0.0.27"
  }
}
