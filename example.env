# Required runtime settings
TIMESCALE_HOST=timescale
TIMESCALE_PORT=5432
TIMESCALE_USER=user
TIMESCALE_PASSWORD=password
TIMESCALE_DB=clashking
TIMESCALE_SSLMODE=disable
ENCRYPTION_KEY=fernet_key
SECRET_KEY=jwt_access_secret
REFRESH_SECRET=jwt_refresh_secret
NATIVE_TOKEN_AUDIENCE=clashking-native
WEB_TOKEN_AUDIENCE=clashking-web
WEB_ALLOWED_ORIGINS=https://clashk.ing,https://dash.clashk.ing
BOT_TOKEN=discord_bot_token
API_BOT_TOKEN=service_to_service_bot_token
PROXY_BASE_URL=http://clashking-proxy:8011
AI_USAGE_SECRET=shared_secret_matching_the_ai_worker

# Discord OAuth
DISCORD_CLIENT_ID=discord_application_id
DISCORD_CLIENT_SECRET=discord_oauth_secret
DISCORD_REDIRECT_URI=https://dash.clashk.ing/auth/callback

# Email authentication
SMTP_USERNAME=smtp_username
SMTP_PASSWORD=smtp_password
SMTP_FROM=noreply@clashk.ing
SMTP_REPLY_TO=noreply@clashk.ing
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_SSL_TLS=false

# Optional integrations
AI_ROSTER_MAX_PROMPT_CHARS=12000
AI_ROSTER_MEMBERSHIP_MAX_CHANGES=1000
ROSTER_REFRESH_COOLDOWN_MINUTES=15
REDIS_IP=valkey
REDIS_PW=valkey_password
BUNNY_ACCESS_KEY=bunny_access_key
API_ANALYTICS_KEY=analytics_token
INTERNAL_API_TOKEN=internal_api_token
LINK_API_USER=link_api_user
LINK_API_PW=link_api_password
COC_EMAIL=clash_api_email
COC_PASSWORD=clash_api_password
SENTRY_DSN_API=https://public@example.ingest.sentry.io/project
APP_SENTRY_DSN=https://public@example.ingest.sentry.io/project
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_MONTHLY_PRICE_ID=price_replace_me
STRIPE_CHECKOUT_SUCCESS_URL=https://dash.clashk.ing/dashboard/settings?checkout=success
STRIPE_CHECKOUT_CANCEL_URL=https://dash.clashk.ing/dashboard/settings?checkout=cancelled
STRIPE_PORTAL_RETURN_URL=https://dash.clashk.ing/dashboard/settings
LOG_LEVEL=INFO

# Local development only
LOCAL=false
DEV_USER_ID=local_user_id
LISTEN_HOST=127.0.0.1
LISTEN_PORT=8000
