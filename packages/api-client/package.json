{
  "name": "@clashking/api-client",
  "version": "0.1.0-rc.28",
  "license": "SEE LICENSE IN LICENSE",
  "description": "Effect-based transport, auth, service-binding execution, and decoding for the ClashKing v2 API",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ClashKingInc/ClashKingAPI.git",
    "directory": "packages/api-client"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "prepack": "node ../../scripts/prepare-package-license.mjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false"
  },
  "dependencies": {
    "@clashking/api-contracts": "0.1.0-rc.28",
    "effect": "4.0.0"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "effect": "4.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  }
}
