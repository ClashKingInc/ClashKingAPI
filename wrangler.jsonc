{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clashking-api",
  "main": "workers/api/src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "build": {
    "command": "npm run docs:build",
    "cwd": ".",
    "watch_dir": ["packages", "scripts", "workers/api/src"]
  },
  "rules": [{ "type": "Data", "globs": ["**/*.zdict"], "fallthrough": true }],
  "workers_dev": false,
  "triggers": { "crons": ["* * * * *"] },
  "preview_urls": true,
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "durable_objects": {
    "bindings": [
      { "name": "TICKET_RUNTIME", "class_name": "TicketRuntimeCoordinator" },
      { "name": "RUNTIME_RECOVERY", "class_name": "RuntimeRecoveryCoordinator" }
    ]
  },
  "migrations": [
    { "tag": "ticket-runtime-v1", "new_sqlite_classes": ["TicketRuntimeCoordinator"] },
    { "tag": "ticket-recovery-v1", "new_sqlite_classes": ["RuntimeRecoveryCoordinator"] }
  ],
  "analytics_engine_datasets": [
    { "binding": "API_REQUEST_TIMINGS", "dataset": "clashking_api_request_timings" }
  ],
  "secrets": {
    "required": [
      "DATA_ENCRYPTION_KEY",
      "DISCORD_CLIENT_ID",
      "DISCORD_CLIENT_SECRET",
      "JWT_ACCESS_SECRET",
      "JWT_REFRESH_SECRET",
      "SMTP_USERNAME",
      "SMTP_PASSWORD"
    ]
  },
  // Only generated public API reference files, never repository/source output.
  // Worker-first keeps every /v2 route and unknown path in the API router.
  "assets": {
    "directory": "./workers/api/documentation-assets",
    "binding": "API_DOCUMENTATION",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  // Timescale is private on the single-homed netcup API host. Port 22 is the
  // existing public TCP probe; PostgreSQL remains bound to loopback only.
  "placement": { "host": "152.53.82.182:22" },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    // Invocation records and automatic traces contain bearer transcript URLs.
    // Application logs remain available for non-transcript requests only.
    "logs": { "enabled": true, "invocation_logs": false },
    "traces": { "enabled": false }
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "aca44651f2604a208a96cae255265d0b"
    },
    {
      "binding": "HYPERDRIVE_FRESH",
      "id": "30ebb4a7f82a4923ae0982d4bd2d407b"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "API_CACHE",
      "id": "c453223f6f344d3086c2a15877d1ad51"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ASSETS",
      "bucket_name": "clashking-assets"
    },
    {
      "binding": "WAR_ARCHIVE",
      "bucket_name": "clashking-wars"
    },
    {
      "binding": "POSTS",
      "bucket_name": "clashking-posts"
    },
    {
      "binding": "APP_UPDATES",
      "bucket_name": "clashking-app-updates"
    },
    {
      "binding": "MEDIA",
      "bucket_name": "clashking-media"
    },
    {
      "binding": "TICKETING",
      "bucket_name": "clashking-ticketing"
    }
  ],
  // These origins stay private on the database host and are reached through
  // the same Cloudflare tunnel as Hyperdrive.
  "vpc_networks": [
    {
      "binding": "CLAN_CACHE_NETWORK",
      "tunnel_id": "12ee1000-f012-4631-84e1-57d405f92809",
      "remote": true
    }
  ],
  "vpc_services": [
    {
      "binding": "CLASH_PROXY",
      "service_id": "01a0786e-ed47-7b00-bbb3-1fc23455f51b"
    },
    {
      "binding": "ELASTICSEARCH",
      "service_id": "01a0786f-3397-71c0-af9e-419ab0a91c08"
    }
  ],
  "vars": {
    "CLAN_CACHE_HOST": "127.0.0.1",
    "CLAN_CACHE_PORT": "6379",
    "CLAN_CACHE_PREFIX": "trackedclans:snapshot:",
    "ENVIRONMENT": "production",
    "STRIPE_MONTHLY_PRICE_ID": "",
    "STRIPE_CHECKOUT_SUCCESS_URL": "",
    "STRIPE_CHECKOUT_CANCEL_URL": "",
    "STRIPE_PORTAL_RETURN_URL": "",
    "ROSTER_REFRESH_COOLDOWN_MINUTES": "15",
    "AI_ROSTER_MAX_PROMPT_CHARS": "12000",
    "ELASTICSEARCH_PLAYERS_ALIAS": "clashking_players",
    "ELASTICSEARCH_CLANS_ALIAS": "clashking_clans",
    "DISCORD_API_ORIGIN": "https://discord.com/api/v10",
    "DISCORD_PUBLIC_KEY": "a35e4dbf82680e2be768f2ca1590e05f9edc7f65ef5f45baf8de381e30058c9d",
    "DISCORD_APPLICATION_ID": "824653933347209227",
    "DISCORD_MAIN_APPLICATION_ID": "824653933347209227",
    "DISCORD_TICKET_NOTIFICATIONS_ENABLED": "false",
    "DISCORD_REDIRECT_URI": "https://dash.clashk.ing/auth/callback",
    "SMTP_HOST": "smtp.purelymail.com",
    "SMTP_PORT": "587",
    "SMTP_STARTTLS": "true",
    "SMTP_SSL_TLS": "false",
    "SMTP_FROM_ADDRESS": "noreply@clashk.ing",
    "SMTP_REPLY_TO_ADDRESS": "noreply@clashk.ing",
    "ADMIN_NOTIFICATION_LAB_ENABLED": "false",
    "ADMIN_ALLOWED_ORIGINS": "https://admin.clashk.ing",
    "WEB_ALLOWED_ORIGINS": "https://dash.clashk.ing,http://localhost:3002,http://localhost:8081",
    "ACCESS_TEAM_DOMAIN": "https://clashking.cloudflareaccess.com",
    "ACCESS_AUDIENCE": "5006fd0bf7e36149bd38fae3b186eb51978c1eac8a483322ba173758e84f09fb",
    "NATIVE_TOKEN_AUDIENCE": "clashking-native",
    "WEB_TOKEN_AUDIENCE": "clashking-web",
    "IOS_MINIMUM_VERSION": "0.0.0",
    "IOS_STORE_URL": "https://apps.apple.com/us/app/clashking/id6502886269",
    "ANDROID_MINIMUM_VERSION": "0.0.0",
    "ANDROID_STORE_URL": "https://play.google.com/store/apps/details?id=ing.clashk",
    "FORCED_UPDATE_MESSAGE": "A newer version of ClashKing is required.",
    "POSTS_PUBLIC_ORIGIN": "https://posts.clashk.ing",
    "APP_UPDATES_PUBLIC_ORIGIN": "https://updates.clashk.ing",
    "TENOR_ALLOWED_HOSTS": "tenor.com,www.tenor.com",
    "TENOR_MEDIA_ALLOWED_HOSTS": "media.tenor.com,c.tenor.com"
  }
}
