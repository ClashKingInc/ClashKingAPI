{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "clashking-badges",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "badges.clashk.ing",
      "custom_domain": true
    }
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "aca44651f2604a208a96cae255265d0b"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
