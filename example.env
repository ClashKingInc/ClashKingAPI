# Shared Timescale connection
TIMESCALE_HOST=timescale
TIMESCALE_PORT=5432
TIMESCALE_DATABASE=clashking
TIMESCALE_USERNAME=clashking
TIMESCALE_PASSWORD=replace_me
TIMESCALE_SSLMODE=disable

# Shared Valkey connection
VALKEY_HOST=valkey
VALKEY_PORT=6379
VALKEY_PASSWORD=replace_me

# Read-only Elasticsearch search access. Use a separate API key from PGSync.
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_API_KEY=replace_with_base64_api_key_credential
ELASTICSEARCH_PLAYERS_ALIAS=clashking_players
ELASTICSEARCH_CLANS_ALIAS=clashking_clans

# ClashKing service origins. Origins never include API path prefixes.
CLASHKING_LANDING_ORIGIN=https://clashk.ing
CLASHKING_DASHBOARD_ORIGIN=https://dash.clashk.ing
CLASHKING_CONNECT_ORIGIN=https://connect.clashk.ing
CLASHKING_PROXY_INTERNAL_ORIGIN=http://clashking-proxy:8011
WAR_ARCHIVE_ORIGIN=https://wars.clashk.ing

# Authentication, encryption, and service trust
DATA_ENCRYPTION_KEY=replace_with_existing_fernet_key
JWT_ACCESS_SECRET=replace_me
JWT_REFRESH_SECRET=replace_me
NATIVE_TOKEN_AUDIENCE=clashking-native
WEB_TOKEN_AUDIENCE=clashking-web
API_BOT_TOKEN=replace_me
AI_USAGE_SECRET=replace_me

# Discord
DISCORD_CLIENT_ID=replace_me
DISCORD_CLIENT_SECRET=replace_me
DISCORD_BOT_TOKEN=replace_me

# Email authentication
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=replace_me
SMTP_PASSWORD=replace_me
SMTP_FROM_ADDRESS=noreply@clashk.ing
SMTP_REPLY_TO_ADDRESS=noreply@clashk.ing
SMTP_STARTTLS=true
SMTP_SSL_TLS=false

# Optional integrations
AI_ROSTER_MAX_PROMPT_CHARS=12000
AI_ROSTER_MEMBERSHIP_MAX_CHANGES=1000
ROSTER_REFRESH_COOLDOWN_MINUTES=15
BUNNY_ACCESS_KEY=
SENTRY_DSN_API=
SENTRY_DSN_MOBILE=

# Billing remains unavailable while the subscription_support feature flag is disabled.
STRIPE_RESTRICTED_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MONTHLY_PRICE_ID=

# Process-local runtime settings
LOCAL=false
DEV_USER_ID=
LISTEN_HOST=0.0.0.0
LISTEN_PORT=8010
LOG_LEVEL=INFO
